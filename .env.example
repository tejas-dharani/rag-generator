# Copy this file to `.env` and fill in your own values. `.env` is gitignored.

# ---- LLM ----
# openai | ollama | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=your-openai-key-here
# For Ollama (no key needed): LLM_PROVIDER=ollama and LLM_MODEL=<a model you pulled, e.g. qwen2.5:7b>
OLLAMA_BASE_URL=http://localhost:11434/v1
# For Claude: LLM_PROVIDER=anthropic, pip install anthropic, set the model and key
ANTHROPIC_API_KEY=

# ---- Embeddings (local by default, no key needed) ----
# fastembed | openai
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ---- Retrieval / chunking defaults (can be overridden per collection) ----
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=5
CANDIDATES=20

# ---- App ----
DATA_DIR=./data
MAX_UPLOAD_MB=25
